# Copiá este archivo como .env y completá con los datos de tu proyecto de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > Configuración del SDK)
# Sin este archivo la app funciona en modo demostración (datos guardados en el navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Realtime Database > URL que aparece arriba de los datos (termina en firebasedatabase.app o firebaseio.com)
VITE_FIREBASE_DATABASE_URL=

# Email con el que se registra el profesor: esa cuenta recibe permisos de profesor.
VITE_TEACHER_EMAIL=

# Opcional: servidor TURN para la videollamada en redes muy cerradas (separar varias URLs con coma)
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
