{
  "rules": {
    "members": {
      ".read": "auth != null && auth.token.email == 'mtsfaust@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.token.email == 'mtsfaust@gmail.com'",
        ".validate": "newData.isBoolean()"
      }
    },
    "boards": {
      "$sessionId": {
        ".read": "auth != null && (auth.token.email == 'mtsfaust@gmail.com' || root.child('members').child(auth.uid).val() == true)",
        ".write": "auth != null && auth.token.email == 'mtsfaust@gmail.com'",
        "ops": {
          "$opId": {
            ".write": "auth != null && root.child('members').child(auth.uid).val() == true && !data.exists()"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('members').child(auth.uid).val() == true"
          }
        },
        "cursors": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('members').child(auth.uid).val() == true"
          }
        },
        "drafts": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('members').child(auth.uid).val() == true"
          }
        }
      }
    }
  }
}
