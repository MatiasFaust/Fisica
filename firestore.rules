rules_version = '2';

// Reglas de Firestore.
// Solo el profesor y los alumnos que él aprobó pueden leer o modificar datos del curso.
// IMPORTANTE: el email del profesor tiene que coincidir con VITE_TEACHER_EMAIL (.env)
// y con el de database.rules.json.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isTeacher() {
      return hasProfile() && myProfile().role == 'teacher';
    }
    function isMember() {
      return hasProfile() && (myProfile().role == 'teacher' || myProfile().status == 'approved');
    }

    match /users/{userId} {
      // Cada uno ve su propio perfil (para saber si ya lo aprobaron); los miembros ven a todos.
      allow read: if (signedIn() && request.auth.uid == userId) || isMember();
      // Los alumnos se crean "pendientes". Solo el email del profesor puede tener el perfil de profesor.
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email.lower()
        && ((request.resource.data.role == 'student' && request.resource.data.status == 'pending')
            || (request.resource.data.role == 'teacher' && request.resource.data.status == 'approved'
                && request.auth.token.email.lower() == 'mtsfaust@gmail.com'));
      // Cada uno edita su nombre y color, pero no su rol ni su estado.
      // El profesor aprueba o bloquea alumnos (sin poder cambiarles el rol).
      allow update: if (signedIn() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status)
        || (isTeacher() && request.resource.data.role == resource.data.role);
      allow delete: if isTeacher();
    }

    // Material del curso: lo ven los miembros, lo modifica solo el profesor.
    match /folders/{id} {
      allow read: if isMember();
      allow write: if isTeacher();
    }
    match /topics/{id} {
      allow read: if isMember();
      allow write: if isTeacher();
    }
    match /exercises/{id} {
      allow read: if isMember();
      allow write: if isTeacher();
    }
    match /sessions/{id} {
      allow read: if isMember();
      allow write: if isTeacher();
    }
    match /savedClasses/{id} {
      allow read: if isMember();
      allow write: if isTeacher();
    }

    // Archivos: los públicos los sube el profesor; cada alumno maneja solo sus archivos privados.
    match /files/{id} {
      allow read: if isMember();
      allow create: if isTeacher()
        || (isMember() && request.resource.data.visibility == 'private' && request.resource.data.ownerId == request.auth.uid);
      allow update: if isTeacher()
        || (isMember() && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == request.auth.uid && request.resource.data.visibility == 'private');
      allow delete: if isTeacher() || (isMember() && resource.data.ownerId == request.auth.uid);
    }

    // Entregas: cada alumno maneja solo las suyas; el profesor ve todas.
    match /submissions/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.studentId == request.auth.uid;
      allow update: if isMember() && resource.data.studentId == request.auth.uid && request.resource.data.studentId == request.auth.uid;
      allow delete: if isTeacher() || (isMember() && resource.data.studentId == request.auth.uid);
    }

    // Actividad reciente: cada miembro registra la propia.
    match /activity/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.userId == request.auth.uid;
      allow delete: if isTeacher();
    }
  }
}
